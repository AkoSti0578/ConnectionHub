<Window x:Class="ConnectionHub.Views.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindow}"
        WindowStartupLocation="CenterOwner"
        Width="440" Title="Aanmelden">
    <StackPanel Margin="24,20,24,20">
        <StackPanel Orientation="Horizontal">
            <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource AccentSoftBrush}" Margin="0,0,14,0">
                <TextBlock Style="{StaticResource Icon}" FontSize="18" Text="&#xE72E;" Foreground="{StaticResource AccentHoverBrush}" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="HeaderText" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="TargetText" Style="{StaticResource Caption}" />
            </StackPanel>
        </StackPanel>

        <TextBlock x:Name="InstructionText" Margin="0,14,0,0" TextWrapping="Wrap" Foreground="{StaticResource SubTextBrush}" />

        <StackPanel x:Name="Fields" Margin="0,4,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="Annuleren" MinWidth="96" Margin="0,0,8,0" IsCancel="True" />
            <Button Content="Doorgaan" MinWidth="96" Style="{StaticResource AccentButton}" IsDefault="True" Click="OnOk" />
        </StackPanel>
    </StackPanel>
</Window>
