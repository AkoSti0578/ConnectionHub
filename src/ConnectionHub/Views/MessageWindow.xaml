<Window x:Class="ConnectionHub.Views.MessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindow}"
        WindowStartupLocation="CenterOwner"
        Width="480" Title="Connection Hub">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="IconBadge" Width="40" Height="40" CornerRadius="20" Background="{StaticResource AccentSoftBrush}"
                VerticalAlignment="Top" Margin="0,2,16,0">
            <TextBlock x:Name="IconGlyph" Style="{StaticResource Icon}" FontSize="18" Text="&#xE946;"
                       Foreground="{StaticResource AccentHoverBrush}" />
        </Border>

        <StackPanel Grid.Column="1">
            <TextBlock x:Name="HeaderText" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBox x:Name="MessageText" Margin="0,10,0,0" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"
                     Background="Transparent" Padding="0" Foreground="{StaticResource SubTextBrush}" MaxHeight="360"
                     VerticalScrollBarVisibility="Auto" />
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button x:Name="SecondaryButton" MinWidth="96" Margin="0,0,8,0" IsCancel="True" Click="OnSecondary" />
            <Button x:Name="PrimaryButton" MinWidth="96" Style="{StaticResource AccentButton}" IsDefault="True" Click="OnPrimary" />
        </StackPanel>
    </Grid>
</Window>
