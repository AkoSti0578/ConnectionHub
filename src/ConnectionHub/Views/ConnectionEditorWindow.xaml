<Window x:Class="ConnectionHub.Views.ConnectionEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindow}"
        SizeToContent="Manual" ResizeMode="CanResize"
        Width="620" Height="760" MinWidth="520" MinHeight="560"
        Title="Verbinding">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Margin="28,22,28,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="HeaderText" Text="Nieuwe verbinding" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="Stel de gegevens van de externe host in." Style="{StaticResource Caption}" Margin="0,2,0,0" />
            </StackPanel>
            <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" CornerRadius="7" Padding="3" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="RdpRadio" Style="{StaticResource SegmentButton}" GroupName="Protocol" Checked="OnProtocolChanged">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7F4;" Margin="0,0,8,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            <TextBlock Text="RDP" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="SshRadio" Style="{StaticResource SegmentButton}" GroupName="Protocol" Checked="OnProtocolChanged">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE756;" Margin="0,0,8,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            <TextBlock Text="SSH" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28,0,22,0">
            <StackPanel Margin="0,0,6,16">
                <TextBlock Text="ALGEMEEN" Style="{StaticResource SectionHeader}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Naam" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                        <TextBox x:Name="NameBox" Tag="bijv. Webserver productie" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Groep" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                        <ComboBox x:Name="GroupCombo" DisplayMemberPath="Label" />
                    </StackPanel>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Host / IP-adres" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="HostBox" Tag="server.domein.local of 10.0.0.10" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Poort" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="PortBox" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="AANMELDGEGEVENS" Style="{StaticResource SectionHeader}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Gebruikersnaam" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                        <TextBox x:Name="UserBox" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" x:Name="DomainPanel">
                        <TextBlock Text="Domein (optioneel)" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                        <TextBox x:Name="DomainBox" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="Wachtwoord" Style="{StaticResource FieldLabel}" />
                <PasswordBox x:Name="PasswordBox" />
                <TextBlock x:Name="PasswordHint" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="Laat leeg om het opgeslagen wachtwoord te behouden." />
                <CheckBox x:Name="ClearPasswordCheck" Content="Opgeslagen wachtwoord verwijderen" />

                <!-- ===== RDP ===== -->
                <TabControl x:Name="RdpTabs" Margin="0,18,0,0">
                    <TabItem Header="Weergave">
                        <StackPanel>
                            <TextBlock Text="Schaling" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="ScalingCombo" SelectionChanged="OnScalingChanged">
                                <ComboBoxItem Content="Dynamische resolutie – resolutie volgt het venster" />
                                <ComboBoxItem Content="Smart sizing – vaste resolutie, geschaald naar venster" />
                                <ComboBoxItem Content="Vaste resolutie (schuifbalken)" />
                            </ComboBox>
                            <Grid x:Name="ResolutionPanel">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Breedte (px)" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="WidthBox" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Hoogte (px)" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="HeightBox" />
                                </StackPanel>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="DPI-schaal op afstand" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="ScaleCombo">
                                        <ComboBoxItem Content="Automatisch (lokaal beeldscherm)" Tag="0" />
                                        <ComboBoxItem Content="100%" Tag="100" />
                                        <ComboBoxItem Content="125%" Tag="125" />
                                        <ComboBoxItem Content="150%" Tag="150" />
                                        <ComboBoxItem Content="175%" Tag="175" />
                                        <ComboBoxItem Content="200%" Tag="200" />
                                        <ComboBoxItem Content="250%" Tag="250" />
                                        <ComboBoxItem Content="300%" Tag="300" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Kleurdiepte" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="ColorCombo">
                                        <ComboBoxItem Content="32 bit (hoogste kwaliteit)" Tag="32" />
                                        <ComboBoxItem Content="24 bit" Tag="24" />
                                        <ComboBoxItem Content="16 bit" Tag="16" />
                                        <ComboBoxItem Content="15 bit" Tag="15" />
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="Lokale bronnen">
                        <StackPanel Margin="0,6,0,0">
                            <CheckBox x:Name="ClipboardCheck" Content="Klembord delen" />
                            <CheckBox x:Name="AudioCheck" Content="Geluid afspelen op deze computer" />
                            <CheckBox x:Name="DrivesCheck" Content="Lokale stations beschikbaar maken" />
                            <CheckBox x:Name="PrintersCheck" Content="Printers doorsturen" />
                            <CheckBox x:Name="SmartCardCheck" Content="Smartcards doorsturen" />
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="Geavanceerd">
                        <StackPanel Margin="0,6,0,0">
                            <CheckBox x:Name="NlaCheck" Content="Network Level Authentication (CredSSP)" />
                            <CheckBox x:Name="AdminCheck" Content="Verbinden met console / admin-sessie" />
                            <TextBlock Text="RD Gateway (optioneel)" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="GatewayBox" Tag="gateway.domein.nl" />
                            <CheckBox x:Name="GatewaySameCredsCheck" Content="Zelfde aanmeldgegevens gebruiken voor de gateway" />
                        </StackPanel>
                    </TabItem>
                </TabControl>

                <!-- ===== SSH ===== -->
                <TabControl x:Name="SshTabs" Margin="0,18,0,0">
                    <TabItem Header="Authenticatie">
                        <StackPanel>
                            <TextBlock Text="Methode" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="AuthCombo">
                                <ComboBoxItem Content="Automatisch (sleutel → wachtwoord → keyboard-interactive / 2FA)" />
                                <ComboBoxItem Content="Wachtwoord (+ 2FA via keyboard-interactive)" />
                                <ComboBoxItem Content="Keyboard-interactive (bijv. wachtwoord + OTP-code)" />
                                <ComboBoxItem Content="Public key (+ 2FA via keyboard-interactive)" />
                            </ComboBox>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Text="Tweestapsverificatie (Google Authenticator, Duo, RADIUS-tokens, ...) wordt via keyboard-interactive gevraagd. Een opgeslagen wachtwoord wordt automatisch ingevuld; alleen de verificatiecode wordt gevraagd." />
                            <TextBlock Text="Private key (OpenSSH / PuTTY)" Style="{StaticResource FieldLabel}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="KeyPathBox" Tag="C:\Users\naam\.ssh\id_ed25519" />
                                <Button Grid.Column="1" Content="Bladeren…" Margin="8,0,0,0" Click="OnBrowseKey" />
                            </Grid>
                            <TextBlock Text="Passphrase van de sleutel" Style="{StaticResource FieldLabel}" />
                            <PasswordBox x:Name="PassphraseBox" />
                            <TextBlock x:Name="PassphraseHint" Style="{StaticResource Caption}" Margin="0,4,0,0"
                                       Text="Laat leeg om de opgeslagen passphrase te behouden." />
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="Terminal">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Lettergrootte" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="FontSizeBox" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Terminaltype" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="TermTypeBox" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Keep-alive (sec)" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="KeepAliveBox" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </TabItem>
                </TabControl>

                <TextBlock Text="NOTITIES" Style="{StaticResource SectionHeader}" />
                <TextBox x:Name="NotesBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" VerticalContentAlignment="Top" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="28,14">
            <Grid>
                <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,220,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Annuleren" MinWidth="96" Margin="0,0,8,0" IsCancel="True" />
                    <Button x:Name="SaveButton" Content="Opslaan" MinWidth="96" Style="{StaticResource AccentButton}" IsDefault="True" Click="OnSave" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
